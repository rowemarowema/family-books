# Family Books — production environment template.
#
# Copy to .env.production on the droplet, chmod 600, fill in every
# replace-me-... value. The .env.production file is gitignored;
# this template is checked in so the variable list is discoverable.
#
# See docs/DEPLOY.md § 5 for the full first-time setup procedure.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-50plus-char-high-entropy-string

# Comma-separated list. The single host is enough for a single-domain
# subdomain deploy.
ALLOWED_HOSTS=books.markrowecontest.com

# Production settings module — selects DEBUG=False, security headers,
# the Resend SMTP backend, etc. Don't change this in prod.
DJANGO_SETTINGS_MODULE=family_books.settings.prod

# Sticky-on 2FA enforcement (see decision #22). Once flipped to true
# in prod, the disable_2fa_enforcement management command is the only
# legitimate path to flip it back, and even that buys a 24h grace
# window before auto-re-enable.
REQUIRE_2FA=true

# ---------------------------------------------------------------------------
# Postgres (consumed by docker-compose.prod.yml)
# ---------------------------------------------------------------------------

POSTGRES_USER=family_books
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-me-with-strong-random-password
POSTGRES_DB=family_books

# DATABASE_URL is constructed by docker-compose.prod.yml from the
# POSTGRES_* vars above; you don't need to set it here.

# ---------------------------------------------------------------------------
# Email (Resend SMTP — decision #9)
# ---------------------------------------------------------------------------

EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=resend
# Get from Resend dashboard → API Keys.
EMAIL_HOST_PASSWORD=replace-me-with-resend-api-key
DEFAULT_FROM_EMAIL=Family Books <noreply@books.markrowecontest.com>

# ---------------------------------------------------------------------------
# Backups → Backblaze B2 (Group H)
# ---------------------------------------------------------------------------

# age public key for encrypting backups. Recovery procedure for the
# matching private key is in docs/ROLLBACK.md § 4 (LastPass-stored
# Secure Note titled "Family Books — age private key").
AGE_RECIPIENT=replace-me-with-age-public-key-starting-with-age1...

# Backblaze B2 (S3-compatible API). Endpoint URL varies by region;
# see Backblaze console → Application Keys.
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=replace-me-from-b2-console
B2_APPLICATION_KEY=replace-me-from-b2-console
B2_BUCKET_NAME=family-books-backups

# Prefix split (Mark's H.5x decision):
#
#   prod/      Production backups go here (the nightly cron).
#   dev-test/  Drill artifacts go here (drill_rollback --use-b2
#              passes --prefix dev-test/ explicitly).
#
# NEVER co-mingle. Production backup history must stay clean of
# drill noise so retention pruning + post-mortem queries are
# unambiguous. See docs/ROLLBACK.md § drill log for the reasoning.
B2_PREFIX=prod/
