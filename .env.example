# Family Books — environment variable template.
# Copy to .env for local dev. NEVER commit .env.
# Prod values live in Render's secret env panel, not here.

# -- Core --
SECRET_KEY=dev-insecure-key-override-in-env
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# -- Database (matches docker-compose defaults) --
DATABASE_URL=postgres://family_books:family_books@localhost:5433/family_books

# -- 2FA --
# Dev default: off. In prod, set REQUIRE_2FA=1 before loading real data.
# NOTE: once enforcement is active in the DB (SystemFlag set to True) flipping
# this back to 0 does NOT disable 2FA — see docs/DECISIONS.md #22.
REQUIRE_2FA=0

# -- Email (prod: Resend SMTP) --
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Family Books <noreply@example.com>"

# -- Backups (Group H wires these up) --
# B2 bucket for encrypted pg_dumps.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# age public key for encrypting backups (the matching private key stays with Mark).
BACKUP_AGE_RECIPIENT=

# -- Price providers (Stage 7) --
# Primary: yfinance (no key). Secondary: Financial Modeling Prep (key required).
FMP_API_KEY=
